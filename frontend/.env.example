# ========================================
# KAIZEN ART & CRAFT - FRONTEND ENVIRONMENT
# ========================================
# Copy this file to .env and fill in the actual values

# ========================================
# BACKEND API CONFIGURATION
# ========================================
# Base URL for backend API calls
# Development: http://localhost:5000/api/v1
# Production: https://your-domain.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# ========================================
# SUPABASE CONFIGURATION (LEGACY/ALTERNATE)
# ========================================
# Note: Currently used only in useProducts hook for product images
# Primary data comes from the Express API backend

# Supabase project URL
# Get from: https://app.supabase.com/projects
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase anonymous public key (safe to expose in frontend)
# Get from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
