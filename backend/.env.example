# ========================================
# KAIZEN ART & CRAFT - BACKEND ENVIRONMENT
# ========================================
# Copy this file to .env and fill in the actual values

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority&appName=app_name
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kaizen?retryWrites=true&w=majority&appName=kaizen

# ========================================
# JWT AUTHENTICATION SECRETS
# ========================================
# Generate strong random strings for these (minimum 32 characters recommended)
# You can generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Secret key for signing JWT access tokens (expires in 15 minutes)
JWT_SECRET=your_jwt_access_token_secret_here_min_32_chars

# Secret key for signing JWT refresh tokens (expires in 7 days)
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_here_min_32_chars

# ========================================
# EMAIL SERVICE (Gmail SMTP)
# ========================================
# Gmail address for sending emails (contact form, notifications)
GMAIL_USER=your_email@gmail.com

# Gmail App-Specific Password (NOT your regular Gmail password)
# How to generate:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Google will generate a 16-character app password
GMAIL_APP_PASSWORD=your_gmail_app_password

# ========================================
# PAYMENT GATEWAY (Razorpay) - NOT YET IMPLEMENTED
# ========================================
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ========================================
# ALTERNATIVE EMAIL SERVICE (NOT CURRENTLY USED)
# ========================================
# Resend API key for email delivery (alternative to Gmail)
# Get from: https://resend.com
# RESEND_API_KEY=your_resend_api_key
